{
    "name": "lung_pet",
    "n_gpu": 1,
    "data_loader":{
      "shuffle": true,
      "batch_size": 16
    },
    "optimizer": {
        "type": "AdamW",
        "args":{
            "lr": 3e-6
        }
    },
    "trainer": {
        "epochs": 10,
        "early_stop": 10,
        "num_frames": 32,
        "num_classes":12,
        "img_size":224,
        "in_chans":3,
        "depth": 2,
        "num_heads":2,
        "model_name": "facebook/timesformer-base-finetuned-k400",
        "modality": 1
    }
}
