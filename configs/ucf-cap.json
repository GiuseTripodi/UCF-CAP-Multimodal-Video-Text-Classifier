{
    "name": "lung_pet",
    "n_gpu": 1,
    "data_loader":{
      "shuffle": true,
      "batch_size": 16
    },
    "optimizer": {
        "type": "AdamW",
        "args":{
            "lr": 5e-5
        }
    },
    "trainer": {
        "epochs": 50,
        "early_stop": 10,
        "num_frames": 32,
        "num_classes":7,
        "img_size":224,
        "in_chans":3,
        "depth": 12,
        "num_heads":12,
        "model_name": "facebook/timesformer-base-finetuned-k400",
        "modality": 1,
        "max_seq_len": 245
    }
}
