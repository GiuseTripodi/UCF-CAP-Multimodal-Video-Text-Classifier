{
    "name": "lung_pet",
    "n_gpu": 1,
    "data_loader":{
      "shuffle": true,
      "batch_size": 100
    },
    "optimizer": {
        "type": "AdamW",
        "args":{
            "lr": 3e-6
        }
    },
    "trainer": {
        "epochs": 5,
        "early_stop": 10,
        "num_frames": 16,
        "num_classes":12,
        "img_size":224,
        "in_chans":3,
        "depth": 4,
        "num_heads":4
    }
}
